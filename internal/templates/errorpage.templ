package templates

templ ErrorPage(message string) {
	<div class="w-full h-full flex items-center justify-center p-4">
		<div class="bg-white rounded-2xl shadow-md p-10 flex flex-col items-center gap-3 max-w-md text-center">
			<div class="w-12 h-12 rounded-full bg-red-100 flex items-center justify-center">
				<svg class="w-6 h-6 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
				</svg>
			</div>
			<h2 class="text-lg font-bold text-stone-800">Something went wrong</h2>
			<p class="text-sm text-stone-500">{ message }</p>
			<a href="/" class="mt-2 px-4 py-2 bg-brand-500 hover:bg-brand-600 text-white text-sm font-semibold rounded-lg shadow transition">Back to dashboard</a>
		</div>
	</div>
}
