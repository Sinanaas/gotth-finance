package templates

templ Reports(catNames []string, catTotals []float64, nwLabels []string, nwValues []float64) {
	<div class="w-full h-full p-4 flex flex-col gap-4">
		<div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
			<!-- Spending by category (this month) -->
			<div class="bg-white rounded-xl shadow-card p-5 border border-stone-100">
				<h2 class="text-base font-semibold font-display text-stone-800 mb-4">Spending by Category</h2>
				<div id="cat-data"
					data-labels={ buildJSONArray(catNames) }
					data-values={ buildJSONFloatArray(catTotals) }
					class="hidden"
				></div>
				if len(catNames) == 0 {
					<p class="text-sm text-stone-400 text-center py-10">No expenses this month yet</p>
				} else {
					<canvas id="category-chart" height="200"></canvas>
				}
			</div>
			<!-- Net worth over time -->
			<div class="bg-white rounded-xl shadow-card p-5 border border-stone-100">
				<h2 class="text-base font-semibold font-display text-stone-800 mb-4">Net Worth Trend</h2>
				<div id="nw-data"
					data-labels={ buildJSONArray(nwLabels) }
					data-values={ buildJSONFloatArray(nwValues) }
					class="hidden"
				></div>
				<canvas id="networth-chart" height="200"></canvas>
			</div>
		</div>
		<script>
			(function () {
				var cat = document.getElementById('cat-data');
				var catCanvas = document.getElementById('category-chart');
				if (cat && catCanvas) {
					new Chart(catCanvas.getContext('2d'), {
						type: 'doughnut',
						data: {
							labels: JSON.parse(cat.dataset.labels),
							datasets: [{
								data: JSON.parse(cat.dataset.values),
								backgroundColor: ['#b8862f','#9c6f28','#caa049','#d9b972','#7d5722','#e8d3a6','#553c1e','#66471f'],
								borderWidth: 0
							}]
						},
						options: { responsive: true, plugins: { legend: { position: 'right', labels: { font: { size: 11 } } } } }
					});
				}
				var nw = document.getElementById('nw-data');
				var nwCanvas = document.getElementById('networth-chart');
				if (nw && nwCanvas) {
					new Chart(nwCanvas.getContext('2d'), {
						type: 'line',
						data: {
							labels: JSON.parse(nw.dataset.labels),
							datasets: [{
								label: 'Net Worth',
								data: JSON.parse(nw.dataset.values),
								borderColor: '#b8862f',
								backgroundColor: 'rgba(184,134,47,0.12)',
								fill: true, tension: 0.3, pointRadius: 3
							}]
						},
						options: {
							responsive: true,
							plugins: { legend: { display: false } },
							scales: { y: { ticks: { callback: function(v){ return 'Rp '+v.toLocaleString('id-ID'); }, font: { size: 11 } } }, x: { grid: { display: false } } }
						}
					});
				}
			})();
		</script>
	</div>
}
