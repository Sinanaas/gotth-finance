package templates

import "github.com/Sinanaas/gotth-financial-tracker/internal/models"
import "fmt"
import "strconv"

templ Transaction(categories []models.Category, transactions []models.Transaction, accounts []models.Account, transactionType []string, total int64) {
<div class="w-full h-full flex gap-6 p-4">

	<!-- Left: Add Transaction Form -->
	<div class="w-80 shrink-0">
		<form
			hx-post="/transaction"
			hx-trigger="submit"
			hx-encoding="application/x-www-form-urlencoded"
			hx-swap="none"
			class="flex flex-col bg-white rounded-xl shadow-md p-6 gap-4"
		>
			<h2 class="text-lg font-bold text-gray-700 border-b border-gray-100 pb-3">Add Transaction</h2>

			<!-- Type Toggle -->
			<div class="flex flex-col gap-1.5">
				<label class="text-xs font-semibold text-gray-500 uppercase tracking-wide">Type</label>
				<div class="flex rounded-lg overflow-hidden border border-gray-200">
					for i := 0; i < len(transactionType); i++ {
					<label class="flex-1 cursor-pointer text-center">
						<input type="radio" name="Type" value={ strconv.Itoa(i) } class="hidden peer" required/>
						<span class="block py-2 text-xs font-semibold text-gray-500 peer-checked:bg-amber-500 peer-checked:text-white hover:bg-gray-50 transition-colors select-none">
							{ transactionType[i] }
						</span>
					</label>
					}
				</div>
			</div>

			<!-- Amount -->
			<div class="flex flex-col gap-1.5">
				<label for="amount" class="text-xs font-semibold text-gray-500 uppercase tracking-wide">Amount</label>
				<div class="flex items-center border border-gray-200 rounded-lg overflow-hidden focus-within:ring-2 focus-within:ring-amber-400">
					<span class="px-3 text-sm text-gray-400 bg-gray-50 border-r border-gray-200 py-2">Rp.</span>
					<input
						type="number"
						name="Amount"
						id="amount"
						placeholder="0"
						class="flex-1 p-2 text-sm outline-none"
						min="0"
						required
						onkeyup="this.setCustomValidity('')"
					/>
				</div>
			</div>

			<!-- Description -->
			<div class="flex flex-col gap-1.5">
				<label for="description" class="text-xs font-semibold text-gray-500 uppercase tracking-wide">Description</label>
				<input
					type="text"
					name="Description"
					id="description"
					placeholder="Enter description"
					class="rounded-lg p-2 border border-gray-200 text-sm focus:outline-none focus:ring-2 focus:ring-amber-400"
					required
					oninvalid="this.setCustomValidity('Please enter a description.')"
					oninput="this.setCustomValidity('')"
				/>
			</div>

			<!-- Category -->
			<div class="flex flex-col gap-1.5">
				<label for="category" class="text-xs font-semibold text-gray-500 uppercase tracking-wide">Category</label>
				<select
					name="Category"
					id="category"
					class="rounded-lg p-2 border border-gray-200 text-sm focus:outline-none focus:ring-2 focus:ring-amber-400 bg-white"
					required
					oninvalid="this.setCustomValidity('Please select a category.')"
					oninput="this.setCustomValidity('')"
				>
					<option disabled selected value class="text-gray-400">Select category...</option>
					for _, category := range categories {
					<option value={ fmt.Sprintf("%s", category.ID) }>{ category.Name }</option>
					}
				</select>
			</div>

			<!-- Account -->
			<div class="flex flex-col gap-1.5">
				<label for="account" class="text-xs font-semibold text-gray-500 uppercase tracking-wide">Account</label>
				<select
					name="Account"
					id="account"
					class="rounded-lg p-2 border border-gray-200 text-sm focus:outline-none focus:ring-2 focus:ring-amber-400 bg-white"
					hx-get="/account/balance"
					hx-target="#balance"
					hx-params="Account"
					hx-swap="innerHTML"
					required
					oninvalid="this.setCustomValidity('Please select an account.')"
					oninput="this.setCustomValidity('')"
				>
					<option disabled selected value class="text-gray-400">Select account...</option>
					for _, account := range accounts {
					<option value={ fmt.Sprintf("%s", account.ID) }>{ account.Name }</option>
					}
				</select>
				<div id="balance"></div>
			</div>

			<!-- Date -->
			<div class="flex flex-col gap-1.5">
				<label for="date" class="text-xs font-semibold text-gray-500 uppercase tracking-wide">Date</label>
				<input
					type="date"
					name="Date"
					id="date"
					class="rounded-lg p-2 border border-gray-200 text-sm focus:outline-none focus:ring-2 focus:ring-amber-400"
					required
					oninvalid="this.setCustomValidity('Please select a date.')"
					oninput="this.setCustomValidity('')"
				/>
			</div>

			<button type="submit" class="mt-2 bg-amber-500 hover:bg-amber-600 text-white font-semibold py-2.5 rounded-lg shadow transition text-sm">
				&#10133; Add Transaction
			</button>
		</form>
	</div>

	<!-- Right: Filter + Transactions Table -->
	<div class="flex-1 flex flex-col min-h-0 gap-3">

		<!-- Filter bar -->
		<form
			id="filter-form"
			hx-get="/transaction/list"
			hx-target="#tx-table-body"
			hx-swap="innerHTML"
			hx-trigger="change, input delay:400ms from:[name='Search']"
			class="bg-white rounded-xl shadow-md px-5 py-3 flex flex-wrap gap-3 items-end"
		>
			<div class="flex flex-col gap-1 flex-1 min-w-36">
				<label class="text-xs font-semibold text-gray-400 uppercase tracking-wide">Search</label>
				<input
					type="text"
					name="Search"
					placeholder="Description..."
					class="rounded-lg border border-gray-200 px-3 py-1.5 text-sm focus:outline-none focus:ring-2 focus:ring-amber-400"
				/>
			</div>
			<div class="flex flex-col gap-1">
				<label class="text-xs font-semibold text-gray-400 uppercase tracking-wide">Type</label>
				<select name="Type" class="rounded-lg border border-gray-200 px-3 py-1.5 text-sm focus:outline-none focus:ring-2 focus:ring-amber-400 bg-white">
					<option value="-1">All</option>
					<option value="1">Income</option>
					<option value="0">Expense</option>
				</select>
			</div>
			<div class="flex flex-col gap-1">
				<label class="text-xs font-semibold text-gray-400 uppercase tracking-wide">Category</label>
				<select name="Category" class="rounded-lg border border-gray-200 px-3 py-1.5 text-sm focus:outline-none focus:ring-2 focus:ring-amber-400 bg-white">
					<option value="">All categories</option>
					for _, category := range categories {
					<option value={ fmt.Sprintf("%s", category.ID) }>{ category.Name }</option>
					}
				</select>
			</div>
			<div class="flex flex-col gap-1">
				<label class="text-xs font-semibold text-gray-400 uppercase tracking-wide">Account</label>
				<select name="Account" class="rounded-lg border border-gray-200 px-3 py-1.5 text-sm focus:outline-none focus:ring-2 focus:ring-amber-400 bg-white">
					<option value="">All accounts</option>
					for _, account := range accounts {
					<option value={ fmt.Sprintf("%s", account.ID) }>{ account.Name }</option>
					}
				</select>
			</div>
			<div class="flex flex-col gap-1">
				<label class="text-xs font-semibold text-gray-400 uppercase tracking-wide">From</label>
				<input type="date" name="StartDate" class="rounded-lg border border-gray-200 px-3 py-1.5 text-sm focus:outline-none focus:ring-2 focus:ring-amber-400"/>
			</div>
			<div class="flex flex-col gap-1">
				<label class="text-xs font-semibold text-gray-400 uppercase tracking-wide">To</label>
				<input type="date" name="EndDate" class="rounded-lg border border-gray-200 px-3 py-1.5 text-sm focus:outline-none focus:ring-2 focus:ring-amber-400"/>
			</div>
			<button
				type="reset"
				class="px-3 py-1.5 text-xs font-semibold text-gray-500 border border-gray-200 rounded-lg hover:bg-gray-50 transition"
				hx-get="/transaction/list"
				hx-target="#tx-table-body"
				hx-swap="innerHTML"
			>Clear</button>
		</form>

		<!-- Table -->
		<div class="bg-white rounded-xl shadow-md flex flex-col flex-1 overflow-hidden">
			<div class="flex items-center justify-between px-6 py-4 border-b border-gray-100">
				<h2 class="text-lg font-bold text-gray-700">All Transactions</h2>
				<span class="text-xs text-gray-400">{ fmt.Sprintf("%d total", total) }</span>
			</div>
			<div class="flex-1 overflow-auto">
				<table class="min-w-full">
					<thead class="sticky top-0 bg-white">
						<tr class="text-left text-xs text-gray-400 uppercase tracking-wider border-b border-gray-100">
							<th class="px-6 py-3">Date</th>
							<th class="px-6 py-3">Description</th>
							<th class="px-6 py-3">Category</th>
							<th class="px-6 py-3">Account</th>
							<th class="px-6 py-3">Amount</th>
							<th class="px-6 py-3 text-center sticky right-0 bg-white shadow-sm">Action</th>
						</tr>
					</thead>
					<tbody id="tx-table-body" class="divide-y divide-gray-50">
						@TransactionListBody(transactions, total, 1, 20)
					</tbody>
				</table>
			</div>
		</div>
	</div>

</div>
}
