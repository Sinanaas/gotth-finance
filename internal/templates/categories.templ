package templates

import "github.com/Sinanaas/gotth-financial-tracker/internal/models"
import "fmt"

templ Categories(categories []models.Category) {
	<div class="w-full h-full flex gap-6 p-4">
		<!-- Left: Add Category Form -->
		<div class="w-80 shrink-0">
			<form
				hx-post="/categories"
				hx-trigger="submit"
				hx-encoding="application/x-www-form-urlencoded"
				hx-swap="none"
				class="flex flex-col bg-white rounded-xl shadow-md p-6 gap-4"
			>
				<h2 class="text-lg font-bold text-gray-700 border-b border-gray-100 pb-3">Add Category</h2>
				<!-- Name -->
				<div class="flex flex-col gap-1.5">
					<label for="name" class="text-xs font-semibold text-gray-500 uppercase tracking-wide">Name</label>
					<input
						type="text"
						name="Name"
						id="name"
						placeholder="Category name"
						class="rounded-lg p-2 border border-gray-200 text-sm focus:outline-none focus:ring-2 focus:ring-amber-400"
						required
						oninvalid="this.setCustomValidity('Please enter a category name.')"
						oninput="this.setCustomValidity('')"
					/>
				</div>
				<!-- Description -->
				<div class="flex flex-col gap-1.5">
					<label for="description" class="text-xs font-semibold text-gray-500 uppercase tracking-wide">Description</label>
					<input
						type="text"
						name="Description"
						id="description"
						placeholder="Short description"
						class="rounded-lg p-2 border border-gray-200 text-sm focus:outline-none focus:ring-2 focus:ring-amber-400"
					/>
				</div>
				<button type="submit" class="mt-2 bg-amber-500 hover:bg-amber-600 text-white font-semibold py-2.5 rounded-lg shadow transition text-sm">
					&#10133; Add Category
				</button>
			</form>
		</div>

		<!-- Right: Categories Table -->
		<div class="flex-1 flex flex-col min-h-0">
			<div class="bg-white rounded-xl shadow-md flex flex-col h-full overflow-hidden">
				<div class="flex items-center justify-between px-6 py-4 border-b border-gray-100">
					<h2 class="text-lg font-bold text-gray-700">All Categories</h2>
					<p class="text-xs text-gray-400">System categories are read-only</p>
				</div>
				<div class="flex-1 overflow-auto">
					<table class="min-w-full">
						<thead class="sticky top-0 bg-white">
							<tr class="text-left text-xs text-gray-400 uppercase tracking-wider border-b border-gray-100">
								<th class="px-6 py-3">Name</th>
								<th class="px-6 py-3">Description</th>
								<th class="px-6 py-3">Type</th>
								<th class="px-6 py-3 text-center sticky right-0 bg-white shadow-sm">Action</th>
							</tr>
						</thead>
						<tbody class="divide-y divide-gray-50">
							if len(categories) == 0 {
							<tr>
								<td colspan="4" class="px-6 py-14 text-center">
									<div class="flex flex-col items-center gap-2">
										<svg class="w-10 h-10 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/>
										</svg>
										<p class="text-sm text-gray-400 font-medium">No categories yet</p>
										<p class="text-xs text-gray-300">Add a custom category using the form on the left</p>
									</div>
								</td>
							</tr>
							}
							for _, category := range categories {
								<tr class="hover:bg-gray-50 transition">
									<td class="px-6 py-3">
										<div class="flex items-center gap-2">
											<span class="w-1.5 h-5 rounded-full bg-amber-400 inline-block"></span>
											<span class="text-sm font-semibold text-gray-700">{ category.Name }</span>
										</div>
									</td>
									<td class="px-6 py-3 text-sm text-gray-500">{ category.Description }</td>
									<td class="px-6 py-3">
										if category.UserID == nil {
											<span class="text-xs px-2 py-0.5 rounded-full bg-gray-100 text-gray-500 font-semibold">System</span>
										} else {
											<span class="text-xs px-2 py-0.5 rounded-full bg-amber-100 text-amber-700 font-semibold">Custom</span>
										}
									</td>
									<td class="px-6 py-3 whitespace-nowrap sticky right-0 bg-white shadow-sm">
										<div class="flex items-center justify-center gap-2">
											if category.UserID != nil {
												<form
													hx-delete={ fmt.Sprintf("/categories/%s", category.ID) }
													hx-trigger="submit"
													hx-encoding="application/x-www-form-urlencoded"
													hx-swap="none"
													class="flex justify-center mb-0"
													confirm-with-sweet-alert="true"
													swal-title="Delete Category?"
													swal-text="This action is irreversible!"
													swal-icon="error"
													swal-buttons="true"
													swal-danger="true"
												>
													<button type="submit" class="text-red-400 hover:text-red-600 transition p-1 rounded hover:bg-red-50" title="Delete">
														<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
															<polyline points="3 6 5 6 21 6"></polyline>
															<path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"></path>
															<path d="M10 11v6M14 11v6"></path>
															<path d="M9 6V4h6v2"></path>
														</svg>
													</button>
												</form>
											} else {
												<span class="text-xs text-gray-300 px-2">—</span>
											}
										</div>
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			</div>
		</div>
	</div>
}
