package templates

import "github.com/Sinanaas/gotth-financial-tracker/internal/models"
import "github.com/Sinanaas/gotth-financial-tracker/internal/utils"
import "fmt"

templ Accounts(accounts []models.Account) {
	<div class="w-full h-full p-4">
		@AccountsPanel(accounts)
		@addAccountModal()
	</div>
}

templ addAccountModal() {
	<div
		id="account-modal"
		data-modal
		class="fixed inset-0 z-50 hidden items-center justify-center bg-ink/40 backdrop-blur-sm p-4 animate-fade-in"
		onclick="if(event.target===this)closeModal('account-modal')"
	>
		<div class="bg-white rounded-2xl shadow-soft w-full max-w-md animate-pop-in overflow-hidden">
			<div class="flex items-center justify-between px-6 py-4 border-b border-stone-100">
				<h2 class="text-base font-semibold font-display text-stone-800">New Account</h2>
				<button type="button" onclick="closeModal('account-modal')" class="text-stone-400 hover:text-stone-600 transition">
					<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
				</button>
			</div>
			<form
				hx-post="/account"
				hx-trigger="submit"
				hx-target="#accounts-panel"
				hx-swap="outerHTML"
				hx-encoding="application/x-www-form-urlencoded"
				hx-on::after-request="if(event.detail.successful){ closeModal('account-modal'); this.reset(); }"
				class="px-6 py-5 flex flex-col gap-4"
				id="account-form"
			>
				<div class="flex flex-col gap-1.5">
					<label for="name" class="text-xs font-semibold text-stone-500 uppercase tracking-wide">Name</label>
					<input
						type="text"
						name="Name"
						id="name"
						placeholder="Account Name"
						class="rounded-lg p-2 border border-stone-200 text-sm focus:outline-none focus:ring-2 focus:ring-brand-400"
						required
						onkeyup="this.setCustomValidity('')"
						hx-on:htmx:validation:validate="
							if (this.value.trim().length < 3) {
								this.setCustomValidity('Account name must be at least 3 characters long.');
								htmx.find('#account-form').reportValidity();
							} else {
								this.setCustomValidity('');
								htmx.find('#account-form').reportValidity();
							}
						"
					/>
				</div>
				<div class="flex flex-col gap-1.5">
					<label for="balance" class="text-xs font-semibold text-stone-500 uppercase tracking-wide">Balance</label>
					<div class="flex items-center border border-stone-200 rounded-lg overflow-hidden focus-within:ring-2 focus-within:ring-brand-400">
						<span class="px-3 text-sm text-stone-400 bg-stone-50 border-r border-stone-200 py-2">Rp.</span>
						<input
							type="number"
							name="Balance"
							id="balance"
							placeholder="0"
							class="flex-1 p-2 text-sm outline-none"
							min="0"
							required
							onkeyup="this.setCustomValidity('')"
						/>
					</div>
				</div>
				<div class="flex flex-col gap-1.5">
					<label for="description" class="text-xs font-semibold text-stone-500 uppercase tracking-wide">Description</label>
					<input
						type="text"
						name="Description"
						id="description"
						placeholder="Account description"
						class="rounded-lg p-2 border border-stone-200 text-sm focus:outline-none focus:ring-2 focus:ring-brand-400"
						required
						onkeyup="this.setCustomValidity('')"
					/>
				</div>
				<div class="flex gap-3 pt-1">
					<button type="button" onclick="closeModal('account-modal')" class="flex-1 py-2.5 rounded-lg border border-stone-200 text-sm font-semibold text-stone-600 hover:bg-stone-50 transition">Cancel</button>
					<button type="submit" class="flex-1 py-2.5 rounded-lg bg-brand-600 hover:bg-brand-700 text-white text-sm font-semibold shadow transition">Add Account</button>
				</div>
			</form>
		</div>
	</div>
}

templ AccountsPanel(accounts []models.Account) {
	<div class="flex flex-col min-h-0 h-full animate-fade-in" id="accounts-panel">
		<div class="bg-white rounded-xl shadow-card flex flex-col h-full overflow-hidden">
			<div class="flex items-center justify-between px-6 py-4 border-b border-stone-100">
				<h2 class="text-lg font-semibold font-display text-stone-800">All Accounts</h2>
				<div class="flex items-center gap-2">
					<button
						hx-get="/accounts/transfer"
						hx-target="#modals-here"
						hx-swap="innerHTML"
						class="flex items-center gap-1.5 px-3 py-1.5 border border-stone-200 hover:bg-stone-50 text-stone-600 text-xs font-semibold rounded-lg transition"
					>
						<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"/>
						</svg>
						Transfer
					</button>
					<button
						type="button"
						onclick="openModal('account-modal')"
						class="flex items-center gap-1.5 px-3 py-1.5 bg-brand-600 hover:bg-brand-700 text-white text-xs font-semibold rounded-lg shadow transition"
					>
						<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
						New Account
					</button>
				</div>
			</div>

			<div class="flex-1 overflow-auto">
				<table class="min-w-full">
					<thead class="sticky top-0 bg-white">
						<tr class="text-left text-xs text-stone-400 uppercase tracking-wider border-b border-stone-100">
							<th class="px-6 py-3">Name</th>
							<th class="px-6 py-3">Balance</th>
							<th class="px-6 py-3">Description</th>
							<th class="px-6 py-3 text-center sticky right-0 bg-white shadow-sm">Action</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-stone-50">
					if len(accounts) == 0 {
					<tr>
						<td colspan="4" class="px-6 py-14 text-center">
							<div class="flex flex-col items-center gap-2">
								<svg class="w-10 h-10 text-stone-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
								</svg>
								<p class="text-sm text-stone-400 font-medium">No accounts yet</p>
								<p class="text-xs text-stone-300">Add your first account with the button above</p>
							</div>
						</td>
					</tr>
					}
					for _, account := range accounts {
					<tr class="hover:bg-stone-50 transition">
						<td class="px-6 py-3">
							<div class="flex items-center gap-2">
								<span class="w-1.5 h-6 rounded-full bg-brand-400 inline-block"></span>
								<span class="text-sm font-semibold text-stone-700">{ account.Name }</span>
							</div>
						</td>
						<td class="px-6 py-3 text-sm font-bold font-mono text-stone-800">Rp. { utils.FormatCurrency(account.Balance) }</td>
						<td class="px-6 py-3 text-sm text-stone-500">{ account.Description }</td>
						<td class="px-6 py-3 whitespace-nowrap sticky right-0 bg-white shadow-sm">
							<div class="flex items-center justify-center gap-2">
								<button
									hx-get={ fmt.Sprintf("/account/%s/edit", account.ID) }
									hx-target="#modals-here"
									hx-swap="innerHTML"
									class="text-brand-500 hover:text-brand-700 transition p-1 rounded hover:bg-brand-50"
									title="Edit"
								>
									<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
								</button>
								<form
									hx-put="/account"
									hx-trigger="submit"
									hx-target="#accounts-panel"
									hx-swap="outerHTML"
									hx-encoding="application/x-www-form-urlencoded"
									class="flex justify-center mb-0"
									confirm-with-sweet-alert="true"
									swal-title="Delete Account?"
									swal-text="This action is irreversible!"
									swal-icon="error"
									swal-buttons="true"
									swal-danger="true"
								>
									<input type="hidden" name="AccountID" value={ fmt.Sprintf("%s", account.ID) }/>
									<button type="submit" class="text-red-400 hover:text-red-600 transition p-1 rounded hover:bg-red-50" title="Delete">
										<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
											<polyline points="3 6 5 6 21 6"></polyline>
											<path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"></path>
											<path d="M10 11v6M14 11v6"></path>
											<path d="M9 6V4h6v2"></path>
										</svg>
									</button>
								</form>
							</div>
						</td>
					</tr>
					}
					</tbody>
				</table>
			</div>
		</div>
	</div>
}

templ EditAccountModal(account models.Account) {
	<div id="account-edit-modal" data-modal class="fixed inset-0 z-50 flex items-center justify-center bg-ink/40 backdrop-blur-sm p-4 animate-fade-in" onclick="if(event.target===this)this.remove()">
		<div class="bg-white rounded-2xl shadow-soft w-full max-w-md animate-pop-in overflow-hidden">
			<div class="flex items-center justify-between px-6 py-4 border-b border-stone-100">
				<h2 class="text-base font-semibold font-display text-stone-800">Edit Account</h2>
				<button type="button" onclick="document.getElementById('account-edit-modal').remove()" class="text-stone-400 hover:text-stone-600 transition">
					<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
				</button>
			</div>
			<form
				hx-patch={ fmt.Sprintf("/account/%s", account.ID) }
				hx-trigger="submit"
				hx-target="#accounts-panel"
				hx-swap="outerHTML"
				hx-encoding="application/x-www-form-urlencoded"
				hx-on::after-request="if(event.detail.successful) document.getElementById('account-edit-modal').remove()"
				class="px-6 py-5 flex flex-col gap-4"
			>
				<div class="flex flex-col gap-1.5">
					<label class="text-xs font-semibold text-stone-500 uppercase tracking-wide">Name</label>
					<input type="text" name="Name" value={ account.Name } class="rounded-lg p-2 border border-stone-200 text-sm focus:outline-none focus:ring-2 focus:ring-brand-400" required/>
				</div>
				<div class="flex flex-col gap-1.5">
					<label class="text-xs font-semibold text-stone-500 uppercase tracking-wide">Description</label>
					<input type="text" name="Description" value={ account.Description } class="rounded-lg p-2 border border-stone-200 text-sm focus:outline-none focus:ring-2 focus:ring-brand-400"/>
				</div>
				<div class="flex gap-3 pt-1">
					<button type="button" onclick="document.getElementById('account-edit-modal').remove()" class="flex-1 py-2.5 rounded-lg border border-stone-200 text-sm font-semibold text-stone-600 hover:bg-stone-50 transition">Cancel</button>
					<button type="submit" class="flex-1 py-2.5 rounded-lg bg-brand-600 hover:bg-brand-700 text-white text-sm font-semibold shadow transition">Save Changes</button>
				</div>
			</form>
		</div>
	</div>
}
