package templates

import "github.com/Sinanaas/gotth-financial-tracker/internal/models"
import "github.com/Sinanaas/gotth-financial-tracker/internal/utils"
import "github.com/Sinanaas/gotth-financial-tracker/internal/constants"
import "fmt"
import "math"

templ TransactionListBody(transactions []models.Transaction, total int64, page int, pageSize int) {
	if len(transactions) == 0 {
	<tr>
		<td colspan="6" class="px-6 py-12 text-center">
			<div class="flex flex-col items-center gap-2">
				<svg class="w-10 h-10 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
				</svg>
				<p class="text-sm text-gray-400 font-medium">No transactions found</p>
				<p class="text-xs text-gray-300">Try adjusting your filters</p>
			</div>
		</td>
	</tr>
	} else {
	for _, transaction := range transactions {
	<tr class="hover:bg-gray-50 transition" id={ fmt.Sprintf("tx-%s", transaction.ID) }>
		<td class="px-6 py-3 whitespace-nowrap text-xs text-gray-400">{ transaction.TransactionDate.Format("02 Jan '06") }</td>
		<td class="px-6 py-3">
			<span class="text-sm font-medium text-gray-700">{ transaction.Description }</span>
		</td>
		<td class="px-6 py-3">
			if transaction.TransactionType == constants.Income {
			<span class="text-xs px-2 py-0.5 rounded-full bg-green-100 text-green-700 font-semibold">{ transaction.Category.Name }</span>
			} else {
			<span class="text-xs px-2 py-0.5 rounded-full bg-amber-100 text-amber-700 font-semibold">{ transaction.Category.Name }</span>
			}
		</td>
		<td class="px-6 py-3 text-sm text-gray-500">{ transaction.Account.Name }</td>
		<td class="px-6 py-3 whitespace-nowrap">
			if transaction.TransactionType == constants.Income {
			<span class="text-sm font-bold text-green-600">+Rp. { utils.FormatCurrency(transaction.Amount) }</span>
			} else {
			<span class="text-sm font-bold text-red-500">-Rp. { utils.FormatCurrency(transaction.Amount) }</span>
			}
		</td>
		<td class="px-6 py-3 whitespace-nowrap sticky right-0 bg-white shadow-sm">
			<div class="flex items-center justify-center gap-2">
				<button
					hx-get={ fmt.Sprintf("/transaction/%s/edit", transaction.ID) }
					hx-target="#modals-here"
					hx-swap="innerHTML"
					class="text-amber-400 hover:text-amber-600 transition p-1 rounded hover:bg-amber-50"
					title="Edit"
				>
					<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
						<path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
					</svg>
				</button>
				<form
					hx-put="/transaction"
					hx-trigger="submit"
					hx-encoding="application/x-www-form-urlencoded"
					hx-target="#tx-table-body"
					hx-swap="innerHTML"
					class="flex justify-center mb-0"
					confirm-with-sweet-alert="true"
					swal-title="Delete Transaction?"
					swal-text="This action is irreversible!"
					swal-icon="error"
					swal-buttons="true"
					swal-danger="true"
				>
					<input type="hidden" name="TransactionID" value={ fmt.Sprintf("%s", transaction.ID) }/>
					<input type="hidden" name="AccountID" value={ fmt.Sprintf("%s", transaction.Account.ID) }/>
					<button type="submit" class="text-red-400 hover:text-red-600 transition p-1 rounded hover:bg-red-50" title="Delete">
						<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<polyline points="3 6 5 6 21 6"></polyline>
							<path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"></path>
							<path d="M10 11v6M14 11v6"></path>
							<path d="M9 6V4h6v2"></path>
						</svg>
					</button>
				</form>
			</div>
		</td>
	</tr>
	}
	}

	<!-- Pagination row -->
	@paginationRow(total, page, pageSize)
}

templ paginationRow(total int64, page int, pageSize int) {
	<tr>
		<td colspan="6" class="px-6 py-3 border-t border-gray-100">
			<div class="flex items-center justify-between text-xs text-gray-400">
				<span>{ fmt.Sprintf("%d", total) } transactions</span>
				<div class="flex items-center gap-1">
					if page > 1 {
					<button
						hx-get={ fmt.Sprintf("/transaction/list?page=%d", page-1) }
						hx-target="#tx-table-body"
						hx-swap="innerHTML"
						hx-include="#filter-form"
						class="px-2 py-1 rounded border border-gray-200 hover:bg-gray-50 transition"
					>←</button>
					}
					<span class="px-3 py-1">{ fmt.Sprintf("Page %d of %d", page, int(math.Ceil(float64(total)/float64(pageSize)))) }</span>
					if int64(page*pageSize) < total {
					<button
						hx-get={ fmt.Sprintf("/transaction/list?page=%d", page+1) }
						hx-target="#tx-table-body"
						hx-swap="innerHTML"
						hx-include="#filter-form"
						class="px-2 py-1 rounded border border-gray-200 hover:bg-gray-50 transition"
					>→</button>
					}
				</div>
			</div>
		</td>
	</tr>
}
