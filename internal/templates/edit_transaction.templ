package templates

import "github.com/Sinanaas/gotth-financial-tracker/internal/models"
import "github.com/Sinanaas/gotth-financial-tracker/internal/constants"
import "fmt"
import "strconv"

templ EditTransactionModal(transaction models.Transaction, categories []models.Category, accounts []models.Account) {
<div id="edit-modal-backdrop"
	class="fixed inset-0 z-50 flex items-center justify-center bg-black/50 backdrop-blur-sm"
	onclick="if(event.target===this)document.getElementById('edit-modal-backdrop').remove()"
>
	<div class="bg-white rounded-2xl shadow-2xl w-full max-w-md mx-4 overflow-hidden" onclick="event.stopPropagation()">
		<!-- Header -->
		<div class="flex items-center justify-between px-6 py-4 border-b border-gray-100">
			<h2 class="text-base font-bold text-gray-800">Edit Transaction</h2>
			<button
				type="button"
				class="text-gray-400 hover:text-gray-600 transition"
				onclick="document.getElementById('edit-modal-backdrop').remove()"
			>
				<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
				</svg>
			</button>
		</div>

		<!-- Form -->
		<form
			hx-patch={ fmt.Sprintf("/transaction/%s", transaction.ID) }
			hx-trigger="submit"
			hx-encoding="application/x-www-form-urlencoded"
			hx-on::after-request="document.getElementById('edit-modal-backdrop').remove()"
			class="px-6 py-5 flex flex-col gap-4"
		>
			<input type="hidden" name="OldAccountID" value={ fmt.Sprintf("%s", transaction.AccountID) }/>

			<!-- Type -->
			<div class="flex flex-col gap-1.5">
				<label class="text-xs font-semibold text-gray-500 uppercase tracking-wide">Type</label>
				<div class="flex rounded-lg overflow-hidden border border-gray-200">
					<label class="flex-1 cursor-pointer text-center">
						<input
							type="radio"
							name="Type"
							value="0"
							class="hidden peer"
							if transaction.TransactionType == constants.Expenses {
								checked
							}
						/>
						<span class="block py-2 text-xs font-semibold text-gray-500 peer-checked:bg-amber-500 peer-checked:text-white hover:bg-gray-50 transition-colors select-none">Expense</span>
					</label>
					<label class="flex-1 cursor-pointer text-center">
						<input
							type="radio"
							name="Type"
							value="1"
							class="hidden peer"
							if transaction.TransactionType == constants.Income {
								checked
							}
						/>
						<span class="block py-2 text-xs font-semibold text-gray-500 peer-checked:bg-amber-500 peer-checked:text-white hover:bg-gray-50 transition-colors select-none">Income</span>
					</label>
				</div>
			</div>

			<!-- Amount -->
			<div class="flex flex-col gap-1.5">
				<label class="text-xs font-semibold text-gray-500 uppercase tracking-wide">Amount</label>
				<div class="flex items-center border border-gray-200 rounded-lg overflow-hidden focus-within:ring-2 focus-within:ring-amber-400">
					<span class="px-3 text-sm text-gray-400 bg-gray-50 border-r border-gray-200 py-2">Rp.</span>
					<input
						type="number"
						name="Amount"
						value={ strconv.FormatFloat(transaction.Amount, 'f', 0, 64) }
						class="flex-1 p-2 text-sm outline-none"
						min="0"
						required
					/>
				</div>
			</div>

			<!-- Description -->
			<div class="flex flex-col gap-1.5">
				<label class="text-xs font-semibold text-gray-500 uppercase tracking-wide">Description</label>
				<input
					type="text"
					name="Description"
					value={ transaction.Description }
					class="rounded-lg p-2 border border-gray-200 text-sm focus:outline-none focus:ring-2 focus:ring-amber-400"
					required
				/>
			</div>

			<!-- Category -->
			<div class="flex flex-col gap-1.5">
				<label class="text-xs font-semibold text-gray-500 uppercase tracking-wide">Category</label>
				<select
					name="Category"
					class="rounded-lg p-2 border border-gray-200 text-sm focus:outline-none focus:ring-2 focus:ring-amber-400 bg-white"
					required
				>
					for _, category := range categories {
					<option
						value={ fmt.Sprintf("%s", category.ID) }
						if category.ID == transaction.CategoryID {
							selected
						}
					>{ category.Name }</option>
					}
				</select>
			</div>

			<!-- Account -->
			<div class="flex flex-col gap-1.5">
				<label class="text-xs font-semibold text-gray-500 uppercase tracking-wide">Account</label>
				<select
					name="Account"
					class="rounded-lg p-2 border border-gray-200 text-sm focus:outline-none focus:ring-2 focus:ring-amber-400 bg-white"
					required
				>
					for _, account := range accounts {
					<option
						value={ fmt.Sprintf("%s", account.ID) }
						if account.ID == transaction.AccountID {
							selected
						}
					>{ account.Name }</option>
					}
				</select>
			</div>

			<!-- Date -->
			<div class="flex flex-col gap-1.5">
				<label class="text-xs font-semibold text-gray-500 uppercase tracking-wide">Date</label>
				<input
					type="date"
					name="Date"
					value={ transaction.TransactionDate.Format("2006-01-02") }
					class="rounded-lg p-2 border border-gray-200 text-sm focus:outline-none focus:ring-2 focus:ring-amber-400"
					required
				/>
			</div>

			<!-- Actions -->
			<div class="flex gap-3 pt-2">
				<button
					type="button"
					onclick="document.getElementById('edit-modal-backdrop').remove()"
					class="flex-1 py-2.5 rounded-lg border border-gray-200 text-sm font-semibold text-gray-600 hover:bg-gray-50 transition"
				>
					Cancel
				</button>
				<button
					type="submit"
					class="flex-1 py-2.5 rounded-lg bg-amber-500 hover:bg-amber-600 text-white text-sm font-semibold shadow transition"
				>
					Save Changes
				</button>
			</div>
		</form>
	</div>
</div>
}
