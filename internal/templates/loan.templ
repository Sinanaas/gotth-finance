package templates

import "github.com/Sinanaas/gotth-financial-tracker/internal/models"
import "github.com/Sinanaas/gotth-financial-tracker/internal/utils"
import "github.com/Sinanaas/gotth-financial-tracker/internal/constants"
import "fmt"
import "strconv"

templ Loans(categories []models.Category, loans []models.Loan, accounts []models.Account, transactionType []string) {
	<div class="w-full h-full p-4">
		@LoansPanel(loans)
		@addLoanModal(categories, accounts, transactionType)
	</div>
}

templ addLoanModal(categories []models.Category, accounts []models.Account, transactionType []string) {
	<div
		id="loan-modal"
		data-modal
		class="fixed inset-0 z-50 hidden items-center justify-center bg-ink/40 backdrop-blur-sm p-4 animate-fade-in"
		onclick="if(event.target===this)closeModal('loan-modal')"
	>
		<div class="bg-white rounded-2xl shadow-soft w-full max-w-md animate-pop-in overflow-hidden max-h-[90vh] flex flex-col">
			<div class="flex items-center justify-between px-6 py-4 border-b border-stone-100 shrink-0">
				<h2 class="text-base font-semibold font-display text-stone-800">New Loan</h2>
				<button type="button" onclick="closeModal('loan-modal')" class="text-stone-400 hover:text-stone-600 transition">
					<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
				</button>
			</div>
			<form
				hx-post="/loan"
				hx-trigger="submit"
				hx-target="#loans-panel"
				hx-swap="outerHTML"
				hx-encoding="application/x-www-form-urlencoded"
				hx-on::after-request="if(event.detail.successful){ closeModal('loan-modal'); this.reset(); }"
				class="px-6 py-5 flex flex-col gap-4 overflow-y-auto"
			>
				<div class="flex flex-col gap-1.5">
					<label for="amount" class="text-xs font-semibold text-stone-500 uppercase tracking-wide">Amount</label>
					<div class="flex items-center border border-stone-200 rounded-lg overflow-hidden focus-within:ring-2 focus-within:ring-brand-400">
						<span class="px-3 text-sm text-stone-400 bg-stone-50 border-r border-stone-200 py-2">Rp.</span>
						<input type="number" name="Amount" id="amount" placeholder="0" class="flex-1 p-2 text-sm outline-none" min="0" required onkeyup="this.setCustomValidity('')"/>
					</div>
				</div>
				<div class="flex flex-col gap-1.5">
					<label class="text-xs font-semibold text-stone-500 uppercase tracking-wide">Type</label>
					<div class="flex rounded-lg overflow-hidden border border-stone-200">
						for i := 0; i < len(transactionType); i++ {
							<label class="flex-1 cursor-pointer text-center">
								<input type="radio" name="Type" value={ strconv.Itoa(i) } class="hidden peer" required/>
								<span class="block py-2 text-xs font-semibold text-stone-500 peer-checked:bg-brand-500 peer-checked:text-white hover:bg-stone-50 transition-colors select-none">
									if transactionType[i] == "Expenses" {
										{ "Expenses / Give Loan" }
									} else {
										{ transactionType[i] + " / Borrowed" }
									}
								</span>
							</label>
						}
					</div>
				</div>
				<div class="flex flex-col gap-1.5">
					<label for="account" class="text-xs font-semibold text-stone-500 uppercase tracking-wide">Account</label>
					<select
						name="Account"
						id="account"
						class="rounded-lg p-2 border border-stone-200 text-sm focus:outline-none focus:ring-2 focus:ring-brand-400 bg-white"
						hx-get="/account/balance"
						hx-target="#balance"
						hx-params="Account"
						hx-swap="innerHTML"
						required
						oninvalid="this.setCustomValidity('Please select an account.')"
						oninput="this.setCustomValidity('')"
					>
						<option disabled selected value class="text-stone-400">Select account...</option>
						for _, account := range accounts {
							<option value={ fmt.Sprintf("%s", account.ID) }>{ account.Name }</option>
						}
					</select>
					<div id="balance"></div>
				</div>
				<div class="flex flex-col gap-1.5">
					<label for="towhom" class="text-xs font-semibold text-stone-500 uppercase tracking-wide">To / From Whom</label>
					<input type="text" name="Towhom" id="towhom" placeholder="Person name" class="rounded-lg p-2 border border-stone-200 text-sm focus:outline-none focus:ring-2 focus:ring-brand-400" required oninvalid="this.setCustomValidity('Please enter a name.')" oninput="this.setCustomValidity('')"/>
				</div>
				<div class="flex flex-col gap-1.5">
					<label for="description" class="text-xs font-semibold text-stone-500 uppercase tracking-wide">Description</label>
					<input type="text" name="Description" id="description" placeholder="Description" class="rounded-lg p-2 border border-stone-200 text-sm focus:outline-none focus:ring-2 focus:ring-brand-400" required oninvalid="this.setCustomValidity('Please enter a description.')" oninput="this.setCustomValidity('')"/>
				</div>
				<div class="flex flex-col gap-1.5">
					<label for="date" class="text-xs font-semibold text-stone-500 uppercase tracking-wide">Loan Date</label>
					<input type="date" name="Date" id="date" class="rounded-lg p-2 border border-stone-200 text-sm focus:outline-none focus:ring-2 focus:ring-brand-400" required oninvalid="this.setCustomValidity('Please select a date.')" oninput="this.setCustomValidity('')"/>
				</div>
				<div class="flex flex-col gap-1.5">
					<label for="category" class="text-xs font-semibold text-stone-500 uppercase tracking-wide">Category</label>
					<select name="Category" id="category" class="rounded-lg p-2 border border-stone-200 text-sm focus:outline-none focus:ring-2 focus:ring-brand-400 bg-white" required oninvalid="this.setCustomValidity('Please select a category.')" oninput="this.setCustomValidity('')">
						<option disabled selected value class="text-stone-400">Select category...</option>
						for _, category := range categories {
							if category.Name != "Income" {
								<option value={ fmt.Sprintf("%s", category.ID) }>{ category.Name }</option>
							}
						}
					</select>
				</div>
				<div class="flex gap-3 pt-1">
					<button type="button" onclick="closeModal('loan-modal')" class="flex-1 py-2.5 rounded-lg border border-stone-200 text-sm font-semibold text-stone-600 hover:bg-stone-50 transition">Cancel</button>
					<button type="submit" class="flex-1 py-2.5 rounded-lg bg-brand-600 hover:bg-brand-700 text-white text-sm font-semibold shadow transition">Add Loan</button>
				</div>
			</form>
		</div>
	</div>
}

templ LoansPanel(loans []models.Loan) {
	<div class="flex flex-col min-h-0 h-full animate-fade-in" id="loans-panel">
		<div class="bg-white rounded-xl shadow-card flex flex-col h-full overflow-hidden">
			<div class="flex items-center justify-between px-6 py-4 border-b border-stone-100">
				<h2 class="text-lg font-semibold font-display text-stone-800">Loans</h2>
				<button
					type="button"
					onclick="openModal('loan-modal')"
					class="flex items-center gap-1.5 px-3 py-1.5 bg-brand-600 hover:bg-brand-700 text-white text-xs font-semibold rounded-lg shadow transition"
				>
					<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
					New Loan
				</button>
			</div>
			<div class="flex-1 overflow-auto">
				<table class="min-w-full">
					<thead class="sticky top-0 bg-white">
						<tr class="text-left text-xs text-stone-400 uppercase tracking-wider border-b border-stone-100">
							<th class="px-6 py-3">Date</th>
							<th class="px-6 py-3">Amount</th>
							<th class="px-6 py-3">Description</th>
							<th class="px-6 py-3">To Whom</th>
							<th class="px-6 py-3">Type</th>
							<th class="px-6 py-3">Category</th>
							<th class="px-6 py-3">Account</th>
							<th class="px-6 py-3 text-center sticky right-0 bg-white shadow-sm">Actions</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-stone-50">
						if len(loans) == 0 {
						<tr>
							<td colspan="8" class="px-6 py-14 text-center">
								<div class="flex flex-col items-center gap-2">
									<svg class="w-10 h-10 text-stone-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z"/>
									</svg>
									<p class="text-sm text-stone-400 font-medium">No active loans</p>
									<p class="text-xs text-stone-300">Record a loan with the button above</p>
								</div>
							</td>
						</tr>
						}
						for _, loan := range loans {
							<tr class="hover:bg-stone-50 transition">
								<td class="px-6 py-3 text-xs text-stone-400 whitespace-nowrap">{ loan.LoanDate.Format("02 Jan '06") }</td>
								<td class="px-6 py-3 whitespace-nowrap">
									if loan.TransactionType == constants.Income {
										<span class="text-sm font-bold font-mono text-green-600">Rp. { utils.FormatCurrency(loan.Amount) }</span>
									} else {
										<span class="text-sm font-bold font-mono text-red-500">Rp. { utils.FormatCurrency(loan.Amount) }</span>
									}
								</td>
								<td class="px-6 py-3 text-sm text-stone-700">{ loan.Description }</td>
								<td class="px-6 py-3 text-sm font-medium text-stone-700">{ loan.ToWhom }</td>
								<td class="px-6 py-3">
									if loan.TransactionType == constants.Income {
										<span class="text-xs px-2 py-0.5 rounded-full bg-green-100 text-green-700 font-semibold">{ loan.TransactionType.ToString() }</span>
									} else {
										<span class="text-xs px-2 py-0.5 rounded-full bg-red-100 text-red-700 font-semibold">{ loan.TransactionType.ToString() }</span>
									}
								</td>
								<td class="px-6 py-3 text-sm text-stone-500">{ loan.Category.Name }</td>
								<td class="px-6 py-3 text-sm text-stone-500">{ loan.Account.Name }</td>
								<td class="px-6 py-3 whitespace-nowrap sticky right-0 bg-white shadow-sm">
									<div class="flex items-center justify-center gap-2">
										<form
											hx-post="/loan/finish"
											hx-trigger="submit"
											hx-target="#loans-panel"
											hx-swap="outerHTML"
											hx-encoding="application/x-www-form-urlencoded"
											class="flex justify-center mb-0"
											confirm-with-sweet-alert="true"
											swal-title="Finish Loan"
											swal-text="Are you sure you want to finish this loan?"
											swal-icon="warning"
											swal-buttons="true"
											swal-danger="true"
										>
											<input type="hidden" name="LoanID" value={ fmt.Sprintf("%s", loan.ID) }/>
											<button type="submit" class="text-brand-500 hover:text-brand-700 transition p-1 rounded hover:bg-brand-50" title="Mark as finished">
												<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
													<polyline points="20 6 9 17 4 12"></polyline>
												</svg>
											</button>
										</form>
										<form
											hx-put="/loan"
											hx-trigger="submit"
											hx-target="#loans-panel"
											hx-swap="outerHTML"
											hx-encoding="application/x-www-form-urlencoded"
											class="flex justify-center mb-0"
											confirm-with-sweet-alert="true"
											swal-title="Delete Loan?"
											swal-text="This action is irreversible!"
											swal-icon="error"
											swal-buttons="true"
											swal-danger="true"
										>
											<input type="hidden" name="LoanID" value={ fmt.Sprintf("%s", loan.ID) }/>
											<button type="submit" class="text-red-400 hover:text-red-600 transition p-1 rounded hover:bg-red-50" title="Delete">
												<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
													<polyline points="3 6 5 6 21 6"></polyline>
													<path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"></path>
													<path d="M10 11v6M14 11v6"></path>
													<path d="M9 6V4h6v2"></path>
												</svg>
											</button>
										</form>
									</div>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		</div>
	</div>
}
